# Copy to .env and fill in. Never commit the real file — it's gitignored.

# Arkiv (Tiramisu testnet)
ARKIV_PRIVATE_KEY=              # funder key; signs nothing in the protocol, only funds the three below
ARKIV_PRIVATE_KEY_ATLAS=        # monitoring agent's own signer
ARKIV_PRIVATE_KEY_NOVA=         # remediation worker's own signer
ARKIV_PRIVATE_KEY_SOL=          # second, identical remediation worker's own signer
ARKIV_HTTP_URL=                 # optional — defaults to the SDK's own Tiramisu chain definition

# Swarm (Ethereum Swarm gateway)
SWARM_GATEWAY=                  # optional — defaults to https://api.gateway.ethswarm.org
SWARM_SIGNER_KEY=               # private key that owns the postage batch below
SWARM_POSTAGE_BATCH_ID=         # the postage batch this deployment stamps every chunk against
SWARM_BATCH_DEPTH=              # optional — defaults to 23; must match the batch's actual depth

# Control room (optional)
DEMO_PASSWORD=                  # if set, gates control room start/kill so a public URL can't spend gas or postage for free
