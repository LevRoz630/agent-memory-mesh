# Copy to .env.auditor — kept deliberately separate from .env, since this key must never sit
# alongside ARKIV_PRIVATE_KEY_ATLAS/NOVA/SOL or the Swarm signer/postage credentials.
#
#   node scripts/generate-auditor-key.mjs   # generates this value and its public counterpart
#   node --env-file=.env.auditor scripts/audit-exporter.mjs

AUDITOR_PRIVATE_KEY=
