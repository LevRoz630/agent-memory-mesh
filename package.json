{
  "name": "hydra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "description": "Agent memory as content (Swarm) + expiring index (Arkiv) — ETHRome 2026",
  "scripts": {
    "start": "node --env-file=.env server.mjs",
    "demo:protocol": "node --env-file=.env scripts/orchestrator.mjs",
    "feedback:repro": "node --env-file=.env arkiv-feedback/repro/run-all.mjs",
    "test": "for f in tests/unit/*.mjs; do node \"$f\" || exit 1; done",
    "verify:envelope": "node --env-file=.env tests/live/envelope-live.mjs",
    "verify:lane": "node --env-file=.env tests/live/lane.mjs",
    "verify:takeover": "node --env-file=.env tests/live/takeover.mjs",
    "verify:tie-break": "node --env-file=.env tests/live/tie-break.mjs",
    "verify:profile": "node --env-file=.env tests/live/profile.mjs",
    "verify:chain-watch": "node --env-file=.env tests/live/chain-watch.mjs",
    "verify:fleet": "node --env-file=.env tests/live/fleet.mjs",
    "verify:claim-lapse": "node --env-file=.env tests/live/claim-lapse.mjs",
    "verify:heartbeat-lapse": "node --env-file=.env tests/live/heartbeat-lapse.mjs",
    "verify:peer-outage": "node --env-file=.env tests/live/peer-outage-detection.mjs",
    "roster": "node --env-file=.env scripts/roster.mjs"
  },
  "dependencies": {
    "@arkiv-network/sdk": "^0.8.0",
    "@ethersphere/bee-js": "^13.1.0",
    "express": "^4.21.0",
    "viem": "^2.56.3",
    "ws": "^8.21.3"
  }
}
